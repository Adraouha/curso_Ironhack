# Ejemplo de variables de entorno para desarrollo y produccion
# En local se puede copiar este archivo como .env
# En Render estas variables se anaden en el apartado "Environment Variables"

# Puerto en el que escucha el backend (Render asigna automaticamente su propio PORT)
PORT=3000

# URL publica donde esta desplegado el front-end (GitHub Pages)
# Permite que el backend acepte peticiones desde tu front-end sin errores de CORS
FRONTEND_URL=https://tu-usuario.github.io

# Datos de conexion a la base de datos de Aiven u otro proveedor
DB_HOST=mysql-xxxx-proyecto.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=tu_password_secreta
DB_NAME=defaultdb
